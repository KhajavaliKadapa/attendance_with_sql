{
 "components": {
  "schemas": {
   "EmployeeCreate": {
    "properties": {
     "department": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Department",
      "type": "string"
     },
     "email": {
      "maxLength": 120,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "title": "Email",
      "type": "string"
     },
     "emp_code": {
      "pattern": "^EMP\\d{4,6}$",
      "title": "Emp Code",
      "type": "string"
     },
     "joined_on": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Joined On",
      "type": "string"
     },
     "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "shift_end": {
      "default": "18:30",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Shift End",
      "type": "string"
     },
     "shift_start": {
      "default": "09:30",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Shift Start",
      "type": "string"
     }
    },
    "required": [
     "emp_code",
     "name",
     "email",
     "department",
     "joined_on"
    ],
    "title": "EmployeeCreate",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "PunchInRequest": {
    "properties": {
     "emp_code": {
      "title": "Emp Code",
      "type": "string"
     },
     "punched_at": {
      "anyOf": [
       {
        "maximum": 4102444800000.0,
        "minimum": 100000000000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Punched At"
     },
     "status": {
      "default": "PRESENT",
      "enum": [
       "PRESENT",
       "WFH",
       "ON_DUTY"
      ],
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "emp_code"
    ],
    "title": "PunchInRequest",
    "type": "object"
   },
   "PunchOutRequest": {
    "properties": {
     "emp_code": {
      "title": "Emp Code",
      "type": "string"
     },
     "punched_at": {
      "anyOf": [
       {
        "maximum": 4102444800000.0,
        "minimum": 100000000000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Punched At"
     }
    },
    "required": [
     "emp_code"
    ],
    "title": "PunchOutRequest",
    "type": "object"
   },
   "RegularizeRequest": {
    "properties": {
     "punch_in": {
      "anyOf": [
       {
        "maximum": 4102444800000.0,
        "minimum": 100000000000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Punch In"
     },
     "punch_out": {
      "anyOf": [
       {
        "maximum": 4102444800000.0,
        "minimum": 100000000000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Punch Out"
     },
     "reason": {
      "maxLength": 200,
      "minLength": 5,
      "title": "Reason",
      "type": "string"
     },
     "regularized_by": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Regularized By",
      "type": "string"
     },
     "status": {
      "anyOf": [
       {
        "enum": [
         "PRESENT",
         "WFH",
         "ON_DUTY",
         "ABSENT",
         "LEAVE"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Status"
     }
    },
    "required": [
     "reason",
     "regularized_by"
    ],
    "title": "RegularizeRequest",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
